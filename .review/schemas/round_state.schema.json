{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Round State Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "lifecycle",
    "producer_role",
    "issue",
    "tier",
    "revision",
    "updated_at",
    "base_branch",
    "base_sha",
    "head_sha",
    "worktree_path",
    "contract",
    "acceptance",
    "decisions",
    "prior_findings",
    "commit_scope",
    "live_probes",
    "artifact_pointers"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_type": { "const": "round_state" },
    "lifecycle": { "enum": ["draft", "active", "superseded", "final"] },
    "producer_role": { "const": "CONDUCTOR" },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rationale"],
      "properties": {
        "name": { "enum": ["trivial", "standard", "full_cluster"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "worktree_path": { "type": "string", "minLength": 1 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "touch_allowlist", "verify_filter"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "touch_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verify_filter": { "type": "string", "minLength": 1 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
              "statement": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["open", "decided", "superseded"] },
          "summary": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "source_artifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "resolved", "accepted"] },
          "summary": { "type": "string", "minLength": 1 },
          "source_artifact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commit_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits"],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "subject"],
            "properties": {
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "subject": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "live_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "observed_at", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "observed_at": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "path"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
