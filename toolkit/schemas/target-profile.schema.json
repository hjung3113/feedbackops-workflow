{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Workflow Target Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "runtime", "setup", "verification"],
  "properties": {
    "schema_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["executables"],
      "properties": { "executables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "allow": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
      }
    },
    "setup": { "type": "array", "items": { "$ref": "#/definitions/command" } },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["groups"],
      "properties": {
        "output_bytes": { "type": "integer", "minimum": 256, "description": "UTF-8 byte ceiling per command output; truncation preserves only complete code points." },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/group" } }
      }
    }
  },
  "definitions": {
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "string", "pattern": "^(\\.|[^/][^\\\\]*)$" },
        "env_allow": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
      }
    },
    "extractor": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern", "group"],
      "properties": { "pattern": { "type": "string", "minLength": 1 }, "group": { "type": "integer", "minimum": 0 } }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "required", "commands"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "required": { "const": true },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/command" } },
        "test_count": { "$ref": "#/definitions/extractor", "description": "A miss is published as null canonical FAIL evidence; only an extracted integer above zero can pass." }
      }
    }
  }
}
