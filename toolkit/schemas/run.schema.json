{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Run Marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "issue", "attempt", "started_at", "updated_at", "status"],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_type": { "const": "codex_run" },
    "issue": { "type": "integer" },
    "attempt": { "type": "integer", "minimum": 1 },
    "pid": { "type": "integer" },
    "started_at": { "type": "string", "description": "ISO-8601 timestamp" },
    "updated_at": { "type": "string", "description": "ISO-8601 timestamp" },
    "status": { "enum": ["running", "exited", "killed_stall", "refused", "exhausted"] },
    "exit_code": { "type": "integer" }
  }
}
