{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent workflow transport receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "authoritative", "issue", "adapter", "adapter_version", "capabilities", "external_handle", "worktree_path", "runner", "launched_at", "created_at"],
  "properties": {
    "schema_version": { "enum": ["1", "2", "3"] },
    "artifact_type": { "const": "transport_receipt" },
    "authoritative": { "const": false },
    "issue": { "type": "integer", "minimum": 1 },
    "runtime": { "enum": ["codex", "claude", "opencode"], "description": "Agent runtime selected independently from transport." },
    "role": { "enum": ["conductor", "architect", "implementation", "reviewer", "verifier", "visual", "release"] },
    "runtime_version": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Agent runtime version reported by its capability probe." },
    "adapter": { "enum": ["cmux", "orca", "herdr"] },
    "adapter_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "capabilities": { "type": "array", "minItems": 1, "description": "Launch and read-only inspection capabilities proven before admission.", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "uniqueItems": true },
    "external_handle": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Adapter-owned lifecycle handle; never workflow completion authority." },
    "worktree_path": { "type": "string", "minLength": 1 },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "relative_path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "pattern": "^\\.review/ISSUE-[0-9]+-launch\\.[^/]+/launch\\.sh$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_digest", "policy_digest", "selection_basis", "decision_reason_codes", "selected"],
      "properties": {
        "route_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selection_basis": { "const": "ordered_policy" },
        "decision_reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["model_alloc", "ordered_policy"] },
          "uniqueItems": true
        },
        "selected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "effort"],
          "properties": {
            "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
            "effort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] }
          },
          "oneOf": [
            { "type": "object", "properties": { "model": { "type": "string", "pattern": "^gpt-5[.-]6(?:-|$)" }, "effort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] } } },
            { "type": "object", "properties": { "model": { "type": "string", "not": { "type": "string", "pattern": "^gpt-5[.-]6(?:-|$)" } }, "effort": { "enum": ["low", "medium", "high"] } } }
          ]
        }
      }
    },
    "launched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  },
  "oneOf": [
    { "type": "object", "properties": { "schema_version": { "const": "1" } }, "not": { "type": "object", "required": ["routing"] } },
    {
      "type": "object",
      "required": ["runtime", "role", "runtime_version"],
      "properties": { "schema_version": { "const": "2" } },
      "not": { "type": "object", "required": ["routing"] }
    },
    {
      "type": "object",
      "required": ["runtime", "role", "runtime_version", "routing"],
      "properties": { "schema_version": { "const": "3" } }
    }
  ]
}
