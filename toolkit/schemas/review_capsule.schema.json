{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Derived Re-review Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "producer_role",
    "issue",
    "manifest_revision",
    "head_sha",
    "input_digest",
    "sources",
    "budget",
    "objective",
    "touch_allowlist",
    "prohibitions",
    "acceptance",
    "diff",
    "prior_findings",
    "verification",
    "risks",
    "reviewer_output_contract"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_type": { "const": "review_capsule" },
    "producer_role": { "const": "CONDUCTOR" },
    "issue": { "type": "integer", "minimum": 1 },
    "manifest_revision": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "input_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sources": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/definitions/source" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_tokens",
        "minimum_tokens",
        "truncated_sections",
        "omitted_counts"
      ],
      "properties": {
        "target_tokens": { "type": "integer", "minimum": 1 },
        "minimum_tokens": { "type": "integer", "minimum": 1 },
        "truncated_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "omitted_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diff_files", "prior_findings", "verification", "risks"],
          "properties": {
            "diff_files": { "type": "integer", "minimum": 0 },
            "prior_findings": { "type": "integer", "minimum": 0 },
            "verification": { "type": "integer", "minimum": 0 },
            "risks": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "objective": { "type": "string", "minLength": 1 },
    "touch_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ac" }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "files", "summary"],
      "properties": {
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    },
    "prior_findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "verification": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "reviewer_output_contract": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "enum": ["round_state", "prompt", "review", "pr_draft"] },
        "path": { "type": "string", "pattern": "^[^/].*" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "ac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "severity", "description", "evidence"],
      "properties": {
        "status": { "enum": ["open", "resolved", "accepted"] },
        "severity": { "enum": ["block", "fix", "nit", "unknown"] },
        "description": { "type": "string" },
        "evidence": { "type": "string" }
      }
    }
  }
}
