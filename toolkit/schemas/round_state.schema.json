{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Round State Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "lifecycle",
    "producer_role",
    "issue",
    "tier",
    "revision",
    "updated_at",
    "base_branch",
    "base_sha",
    "head_sha",
    "worktree_path",
    "contract",
    "acceptance",
    "decisions",
    "prior_findings",
    "commit_scope",
    "live_probes",
    "artifact_pointers"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_type": { "const": "round_state" },
    "lifecycle": { "enum": ["draft", "active", "superseded", "final"] },
    "producer_role": { "const": "CONDUCTOR" },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rationale"],
      "properties": {
        "name": { "enum": ["trivial", "standard", "full_cluster"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "worktree_path": { "type": "string", "minLength": 1 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "touch_allowlist",
        "prohibitions",
        "verify_filter",
        "test_discovery_command"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "touch_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "new_file_allowlist": {
          "description": "Explicit target-relative file paths which may be newly created after base_sha. Existing files still require touch_allowlist coverage; globs are deliberately forbidden here so a typo cannot create an arbitrary file.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitions": {
          "description": "Canonical structured prohibitions rendered verbatim into worker and re-review guidance; never reconstruct these with natural-language regexes.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verify_filter": { "type": "string", "minLength": 1 },
        "test_discovery_command": {
          "description": "Target-native command whose stdout is searched for acceptance IDs. Without test_count, each non-empty stdout line counts as one discovered test.",
          "type": "string",
          "minLength": 1
        },
        "test_count": {
          "description": "Optional multiline regular-expression extractor for the positive discovered test count in test_discovery_command stdout.",
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "group"],
          "properties": {
            "pattern": { "type": "string", "minLength": 1 },
            "group": { "type": "integer", "minimum": 0 }
          }
        },
        "chunk_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chunk_id",
            "typecheck_command",
            "compile_consumers",
            "convention_watch"
          ],
          "properties": {
            "chunk_id": { "type": "string", "minLength": 1 },
            "typecheck_command": { "type": "string", "minLength": 1 },
            "compile_consumers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "convention_watch": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surface",
                  "trigger",
                  "expected_invariant",
                  "owner",
                  "review_by_chunk",
                  "closed_by"
                ],
                "properties": {
                  "surface": { "type": "string", "minLength": 1 },
                  "trigger": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "expected_invariant": { "type": "string", "minLength": 1 },
                  "owner": { "type": "string", "minLength": 1 },
                  "review_by_chunk": { "type": "string", "minLength": 1 },
                  "closed_by": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["artifact_type", "checklist_item"],
                    "properties": {
                      "artifact_type": { "const": "review" },
                      "checklist_item": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "expected_test_count"],
      "properties": {
        "expected_test_count": { "type": "integer", "minimum": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$"
              },
              "statement": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "status", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["open", "decided", "superseded"] },
          "summary": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "source_artifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "resolved", "accepted"] },
          "summary": { "type": "string", "minLength": 1 },
          "source_artifact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "round_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failures"],
    "properties": {
    "next_dispatch_ordinal": {
      "type": "integer",
      "minimum": 1,
      "description": "Host-owned monotonic admission counter; it is never derived from mutable failure-array position."
    },
    "last_admission_key": {
      "type": "string",
      "pattern": "^issue-[0-9]+-dispatch-[0-9]+$",
      "description": "Host-owned marker for the most recently consumed normal admission; it remains until a corresponding failure is recorded."
    },
    "blocker_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw_path", "raw_sha256", "reason", "status"],
      "properties": {
        "kind": { "const": "malformed_preexisting_blocker_quarantined" },
        "raw_path": { "type": "string", "minLength": 1 },
        "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reason": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ready", "used"] }
      }
    },
    "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dispatch_ordinal",
              "status",
              "primary_origin",
              "secondary_origins",
              "failed_ac_ids",
              "owner",
              "next_action",
              "evidence"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "dispatch_ordinal": { "type": "integer", "minimum": 1 },
              "status": { "enum": ["open", "closed"] },
              "primary_origin": {
                "enum": [
                  "environment",
                  "dispatch_contract",
                  "implementation",
                  "test_oracle",
                  "verification_harness",
                  "integration_drift"
                ],
                "description": "The redispatch gate gives a BLOCKER-only failure-evidence exception only to dispatch_contract; all other origins still require failed VERIFY or REVIEW evidence."
              },
              "secondary_origins": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "environment",
                    "dispatch_contract",
                    "implementation",
                    "test_oracle",
                    "verification_harness",
                    "integration_drift"
                  ]
                }
              },
              "failed_ac_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "owner": { "type": "string", "minLength": 1 },
              "next_action": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "summary"],
                "properties": {
                  "kind": {
                    "enum": [
                      "environment_fix",
                      "contract_fix",
                      "implementation_fix",
                      "oracle_fix",
                      "harness_fix",
                      "integration_fix",
                      "diagnosis"
                    ]
                  },
                  "summary": { "type": "string", "minLength": 1 }
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "The shared evidence union deliberately permits blocker references. Runtime admission treats a schema-valid, issue/hash/HEAD-bound BLOCKER as sole failed evidence only for primary_origin dispatch_contract, and requires its embedded producer head_sha to equal the evidence reference; it is not a general VERIFY/REVIEW replacement.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "path", "content_sha256", "head_sha"],
                  "properties": {
                    "kind": {
                      "enum": [
                        "verify",
                        "review",
                        "blocker",
                        "live_probe",
                        "dispatch_log",
                        "diff"
                      ],
                      "description": "blocker is eligible as sole failed evidence only under the failure-level dispatch_contract exception enforced by redispatch-check.sh, including producer/reference head_sha equality. live_probe, dispatch_log, and diff are informational references only and cannot satisfy failed-round or closure evidence."
                    },
                    "path": { "type": "string", "minLength": 1 },
                    "content_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "head_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  }
                }
              },
              "closed_by": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path",
                  "content_sha256",
                  "head_sha",
                  "closes_ac_ids"
                ],
                "properties": {
                  "kind": { "enum": ["verify", "review", "superseded_by"] },
                  "path": { "type": "string", "minLength": 1 },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "closes_ac_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "checklist_item": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "security_stop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active", "finding_id", "evidence"],
          "properties": {
            "active": { "type": "boolean" },
            "finding_id": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "content_sha256", "head_sha"],
              "properties": {
                "kind": {
                  "enum": [
                    "verify",
                    "review",
                    "blocker",
                    "live_probe",
                    "dispatch_log",
                    "diff"
                  ]
                },
                "path": { "type": "string", "minLength": 1 },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            }
          }
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger", "failure_ids", "records"],
          "properties": {
            "trigger": { "enum": ["same_origin", "third_redispatch"] },
            "failure_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "summary", "evidence"],
                "properties": {
                  "kind": {
                    "enum": [
                      "oracle_contract_recheck",
                      "hard_fact",
                      "passing_analog"
                    ]
                  },
                  "summary": { "type": "string", "minLength": 1 },
                  "instruction": {
                    "const": "guess_forbidden_copy_passing_analog_to_parity"
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "path", "content_sha256", "head_sha"],
                    "properties": {
                      "kind": {
                        "enum": [
                          "verify",
                          "review",
                          "blocker",
                          "live_probe",
                          "dispatch_log",
                          "diff"
                        ]
                      },
                      "path": { "type": "string", "minLength": 1 },
                      "content_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "head_sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    }
                  }
                }
              }
            },
            "manifest_update": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from_revision", "to_revision", "decision_id"],
              "properties": {
                "from_revision": { "type": "integer", "minimum": 1 },
                "to_revision": { "type": "integer", "minimum": 2 },
                "decision_id": { "type": "string", "minLength": 1 }
              }
            },
            "integrated_fix_batch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dispatch_ordinal", "failure_ids", "status"],
              "properties": {
                "dispatch_ordinal": { "type": "integer", "minimum": 2 },
                "failure_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "status": { "enum": ["ready", "used"] }
              }
            }
          }
        }
      }
    },
    "commit_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits"],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "subject"],
            "properties": {
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "subject": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "live_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "observed_at", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "observed_at": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "path"],
        "properties": {
          "artifact_type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
