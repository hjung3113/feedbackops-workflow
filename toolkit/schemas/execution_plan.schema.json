{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deterministic parallel execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "lifecycle", "producer_role", "issue", "round", "manifest_revision", "plan_revision", "base_head", "seats", "integration_order", "parallel_policy", "required_evidence", "candidate_closure"],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_type": { "const": "execution_plan" },
    "lifecycle": { "enum": ["active", "superseded", "final"] },
    "producer_role": { "const": "CONDUCTOR" },
    "issue": { "type": "integer", "minimum": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "manifest_revision": { "type": "integer", "minimum": 1 },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "base_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "seats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "write_set", "depends_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "write_set": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "paths"],
            "properties": {
              "mode": { "enum": ["exact", "unknown", "dynamic", "broad"] },
              "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "integration_order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "parallel_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_mutation_paths", "database_isolation", "environment_isolation", "rate_limit_budget"],
      "properties": {
        "shared_mutation_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "database_isolation": { "enum": ["isolated_per_seat", "not_required", "unproven"] },
        "environment_isolation": { "enum": ["isolated_per_seat", "unproven"] },
        "rate_limit_budget": { "enum": ["reserved", "not_required", "unproven"] }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["review", "verification", "pr_draft", "completion", "seat_outcome"] }
    },
    "candidate_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_policy", "require_clean_candidate", "unresolved_blockers"],
      "properties": {
        "retry_policy": { "const": "complete_fresh_same_head_set" },
        "require_clean_candidate": { "const": true },
        "unresolved_blockers": { "const": "deny" }
      }
    }
  }
}
