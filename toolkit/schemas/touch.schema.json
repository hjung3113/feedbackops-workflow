{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Touch Declaration Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "lifecycle", "producer_role", "issue", "files", "escalation_required"],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_type": { "const": "touch" },
    "lifecycle": { "enum": ["active", "superseded", "final"] },
    "producer_role": { "enum": ["CODEX", "WORKER", "CONDUCTOR", "REVIEWER", "VERIFIER", "RELEASE"], "description": "Workflow role. CODEX is accepted only as a legacy producer identity." },
    "producer_runtime": { "enum": ["codex", "claude", "opencode"], "description": "Runtime that produced this artifact; required for runtime-neutral artifacts." },
    "producer_version": { "type": "string", "minLength": 1, "description": "Observed runtime CLI version; required for runtime-neutral artifacts." },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": { "number": { "type": "integer" } }
    },
    "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "escalation_required": { "type": "boolean", "description": "true if touches packages/shared, migrations, shared UI, permissions, or auth" }
  },
  "allOf": [{
    "oneOf": [
      { "type": "object", "required": ["producer_role"], "properties": { "producer_role": { "const": "CODEX" } }, "not": { "type": "object", "required": ["producer_runtime"] } },
      { "type": "object", "required": ["producer_role", "producer_runtime", "producer_version"], "properties": { "producer_role": { "enum": ["WORKER", "CONDUCTOR", "REVIEWER", "VERIFIER", "RELEASE"] } } }
    ]
  }]
}
