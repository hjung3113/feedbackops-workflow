# Documents the contract for TARGET repos; copy to the target's .env and fill in.
# When used as a prepare-worktree --env-profile, this file must be self-contained:
# the same profile is written to both <wt>/.env and <wt>/apps/backend/.env.

# OPTIONAL explicit transport selection. CLI --orchestrator wins over this
# variable, which wins over .agent-workflow/workflow-config.json. There is no
# implicit default and no fallback if the selected adapter is unavailable.
AGENT_WORKFLOW_ORCHESTRATOR=cmux

# Local Postgres URL the app/tests use; host MUST be local (localhost or 127.0.0.1).
DATABASE_URL=postgres://fops_app:CHANGEME@localhost:5434/feedbackops

# Migrate-role URL used by drizzle-kit migrate.
DATABASE_URL_MIGRATE=postgres://fops_migrator:CHANGEME@localhost:5434/feedbackops

# Workspace scope for integration tests.
WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# Low-privilege URL the VERIFIER uses instead of DATABASE_URL; avoid superuser 'postgres'.
# REQUIRED whenever VERIFY_ISSUE is set: verify.sh refuses (exit 4) to fall back to
# DATABASE_URL from .env in per-issue mode. Get it from prepare-verify-db.sh's last line.
VERIFY_DATABASE_URL=postgres://fops_verifier:CHANGEME@localhost:5434/feedbackops

# OPTIONAL migrate URL override for the verifier.
VERIFY_DATABASE_URL_MIGRATE=postgres://fops_migrator:CHANGEME@localhost:5434/feedbackops

# REQUIRED for canonical issue verification. The target-owned command prints one
# JSON object with exactly `sentinel` and `migration_hash` checks plus actual
# role `{name,superuser}` evidence. Values must be sanitized statuses/hashes,
# never URLs, credentials, or customer data.
VERIFY_CLEAN_COMMAND=./scripts/verify-clean-state.sh

# OPTIONAL space-separated extra env var names to pass through verify.sh's env -i scrub.
VERIFY_ENV_ALLOW=NODE_OPTIONS FEATURE_FLAG_EXAMPLE

# OPTIONAL issue number; when set, verify.sh requires VERIFY_CLEAN_COMMAND and
# emits .review/ISSUE-<n>-VERIFY.json with clean-state evidence.
VERIFY_ISSUE=33

# OPTIONAL admin URL for prepare-verify-db.sh (or pass --base-url). The role MUST
# have the CREATEDB privilege — on a stock docker-compose.dev.yml box that is
# 'postgres' (port 5434); fops_migrate cannot create databases.
PGADMIN_URL=postgres://postgres:CHANGEME@localhost:5434/postgres

# OPTIONAL verifier identity for prepare-verify-db.sh. Set both or neither:
# the raw password is URL-encoded only in the script's final handoff line and
# is never inferred from PGADMIN_URL. Capture that stdout line; do not log it.
VERIFY_DB_ROLE=fops_verifier
VERIFY_DB_PASSWORD=CHANGEME
